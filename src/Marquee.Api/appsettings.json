{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Microsoft.EntityFrameworkCore": "Warning",
      // EF logs a failed command when it probes for a migrations table that does not exist yet.
      // Real command failures still surface as exceptions.
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical",
      // Unique-index and row-version conflicts are expected outcomes that the handlers deal with
      // (idempotent retries, lost races). EF would log each of them as an error.
      "Microsoft.EntityFrameworkCore.Update": "Critical"
    }
  },
  "AllowedHosts": "*",
  "Booking": {
    "HoldDuration": "00:08:00",
    "PaymentGrace": "00:02:00",
    "MaxSeatsPerReservation": 6
  },
  "WaitingRoom": {
    "Capacity": 50,
    "AdmissionWindow": "00:10:00"
  }
}
